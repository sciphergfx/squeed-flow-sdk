{
          "root.trigger": {
                    "address": "root.trigger",
                    "type": "TriggerConfig",
                    "fields": {
                              "event": {
                                        "$visibleWhen": {
                                                  "$address": "root.trigger.type",
                                                  "$equals": "event"
                                        },
                                        "$requiredWhen": {
                                                  "$address": "root.trigger.type",
                                                  "$equals": "event"
                                        }
                              },
                              "cron": {
                                        "$visibleWhen": {
                                                  "$address": "root.trigger.type",
                                                  "$equals": "schedule"
                                        },
                                        "$requiredWhen": {
                                                  "$address": "root.trigger.type",
                                                  "$equals": "schedule"
                                        }
                              }
                    }
          },
          "root.assistant": {
                    "address": "root.steps.0.config",
                    "type": "LlmConfig",
                    "fields": {
                              "promptId": {
                                        "$label": "Prompt",
                                        "$options": {
                                                  "$source": "callback",
                                                  "$dependsOn": [
                                                            "root.texts"
                                                  ]
                                        }
                              },
                              "instructionIds": {
                                        "$label": "Instructions",
                                        "$options": {
                                                  "$source": "callback",
                                                  "$dependsOn": [
                                                            "root.texts"
                                                  ]
                                        }
                              },
                              "model": {
                                        "$options": {
                                                  "$source": "callback",
                                                  "$dependsOn": []
                                        }
                              },
                              "memory": {
                                        "$label": "Knowledge Base",
                                        "$options": {
                                                  "$source": "callback",
                                                  "$dependsOn": []
                                        }
                              },
                              "tools": {
                                        "$options": {
                                                  "$source": "callback",
                                                  "$dependsOn": [
                                                            "root.tools"
                                                  ]
                                        }
                              }
                    }
          },
          "root.decision": {
                    "address": "root.steps.1.config",
                    "type": "ConditionalConfig",
                    "fields": {
                              "condition": {
                                        "$control": "textarea"
                              }
                    }
          },
          "root.addChannel": {
                    "address": "root.steps.2.config",
                    "type": "HttpConfig",
                    "fields": {
                              "body": {
                                        "$control": "textarea"
                              }
                    }
          },
          "root.directoryTool": {
                    "address": "root.tools.directory_lookup",
                    "type": "ToolConfig",
                    "fields": {
                              "description": {
                                        "$control": "textarea"
                              }
                    }
          },
          "root.issueTool": {
                    "address": "root.tools.issue_lookup",
                    "type": "ToolConfig",
                    "fields": {
                              "description": {
                                        "$control": "textarea"
                              }
                    }
          },
          "root.updateProfile": {
                    "address": "root.steps.3.config",
                    "type": "HttpConfig",
                    "fields": {
                              "body": {
                                        "$control": "textarea"
                              }
                    }
          }
}