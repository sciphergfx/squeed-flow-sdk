{
          "trigger": {
                    "$view": "icon-label",
                    "$label": "On Create User",
                    "$icon": "PiUserPlus",
                    "$bgColor": "teal.600",
                    "$subtitle": {
                              "$state": "root.trigger.event"
                    },
                    "$target": "root.assistant"
          },
          "assistant": {
                    "$label": {
                              "$state": "root.steps.0.name"
                    },
                    "$icon": "PiRobot",
                    "$bgColor": "gray.700",
                    "$target": "root.decision"
          },
          "directoryTool": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.tools.directory_lookup.name"
                    },
                    "$icon": "PiIdentificationBadge",
                    "$bgColor": "teal.700",
                    "$borderRadius": 100
          },
          "issueTool": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.tools.issue_lookup.name"
                    },
                    "$icon": "PiTicket",
                    "$bgColor": "blue.700",
                    "$borderRadius": 100
          },
          "prompt": {
                    "$label": {
                              "$state": "root.texts.user_review.name"
                    },
                    "$content": {
                              "$state": "root.texts.user_review.content"
                    },
                    "$bgColor": "gray.700"
          },
          "instructions": {
                    "$label": {
                              "$state": "root.texts.directory_guidance.name"
                    },
                    "$content": {
                              "$state": "root.texts.directory_guidance.content"
                    },
                    "$bgColor": "gray.700"
          },
          "decision": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.steps.1.name"
                    },
                    "$icon": "PiSignpost",
                    "$bgColor": "green.600",
                    "$connections": [
                              {
                                        "target": "root.addChannel",
                                        "label": "True"
                              },
                              {
                                        "target": "root.updateProfile",
                                        "label": "False"
                              }
                    ]
          },
          "addChannel": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.steps.2.name"
                    },
                    "$icon": "PiSlackLogo",
                    "$bgColor": "gray.700"
          },
          "updateProfile": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.steps.3.name"
                    },
                    "$icon": "PiSlackLogo",
                    "$bgColor": "gray.700"
          }
}