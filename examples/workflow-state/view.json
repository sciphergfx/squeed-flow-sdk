{
          "trigger": {
                    "$view": "icon-label",
                    "$label": "On Create User",
                    "$icon": "PiUserPlus",
                    "$bgColor": "teal.600",
                    "$subtitle": {
                              "$state": "root.trigger.event"
                    },
                    "$connections": [
                              { "id": "trigger-assistant", "target": "root.assistant", "sourceProperty": "output:output", "targetProperty": "input:input" }
                    ]
          },
          "assistant": {
                    "$label": {
                              "$state": "root.steps.0.name"
                    },
                    "$icon": "PiRobot",
                    "$bgColor": "gray.700",
                    "$connections": [
                              { "id": "assistant-decision", "target": "root.decision", "sourceProperty": "output:output", "targetProperty": "input:input" }
                    ]
          },
          "model": {
                    "$view": "icon-label",
                    "$label": { "$state": "root.models.example-model.name" },
                    "$icon": "PiBrain",
                    "$bgColor": "blue.700",
                    "$borderRadius": 100,
                    "$connections": [
                              { "id": "model-assistant", "target": "root.assistant", "sourceProperty": "output:resource", "targetProperty": "config:model", "label": "Model", "style": "dashed" }
                    ]
          },
          "knowledgeMemory": {
                    "$view": "icon-label",
                    "$label": { "$state": "root.memorySources.knowledge_entry.name" },
                    "$icon": "PiDatabase",
                    "$bgColor": "teal.700",
                    "$borderRadius": 100,
                    "$connections": [
                              { "id": "memory-assistant", "target": "root.assistant", "sourceProperty": "output:resource", "targetProperty": "config:memory", "label": "Memory", "style": "dashed" }
                    ]
          },
          "supportMemory": {
                    "$view": "icon-label",
                    "$label": { "$state": "root.memorySources.support_qa.name" },
                    "$icon": "PiDatabase",
                    "$bgColor": "teal.700",
                    "$borderRadius": 100
          },
          "directoryTool": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.tools.directory_lookup.name"
                    },
                    "$icon": "PiIdentificationBadge",
                    "$bgColor": "teal.700",
                    "$borderRadius": 100,
                    "$connections": [
                              { "id": "directory-assistant", "target": "root.assistant", "sourceProperty": "output:resource", "targetProperty": "config:tools", "label": "Directory Tool", "style": "dashed" }
                    ]
          },
          "issueTool": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.tools.issue_lookup.name"
                    },
                    "$icon": "PiTicket",
                    "$bgColor": "blue.700",
                    "$borderRadius": 100,
                    "$connections": [
                              { "id": "issues-assistant", "target": "root.assistant", "sourceProperty": "output:resource", "targetProperty": "config:tools", "label": "Issue Tool", "style": "dashed" }
                    ]
          },
          "prompt": {
                    "$label": {
                              "$state": "root.texts.user_review.name"
                    },
                    "$content": {
                              "$state": "root.texts.user_review.content"
                    },
                    "$bgColor": "gray.700",
                    "$connections": [
                              { "id": "prompt-assistant", "target": "root.assistant", "sourceProperty": "output:resource", "targetProperty": "config:promptId", "label": "Prompt", "style": "dashed" }
                    ]
          },
          "instructions": {
                    "$label": {
                              "$state": "root.texts.directory_guidance.name"
                    },
                    "$content": {
                              "$state": "root.texts.directory_guidance.content"
                    },
                    "$bgColor": "gray.700",
                    "$connections": [
                              { "id": "instructions-assistant", "target": "root.assistant", "sourceProperty": "output:resource", "targetProperty": "config:instructionIds", "label": "Instructions", "style": "dashed" }
                    ]
          },
          "decision": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.steps.1.name"
                    },
                    "$icon": "PiSignpost",
                    "$bgColor": "green.600",
                    "$connections": [
                              {
                                        "target": "root.addChannel",
                                        "sourceProperty": "output:true",
                                        "targetProperty": "input:input",
                                        "label": "True"
                              },
                              {
                                        "target": "root.updateProfile",
                                        "sourceProperty": "output:false",
                                        "targetProperty": "input:input",
                                        "label": "False"
                              }
                    ]
          },
          "addChannel": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.steps.2.name"
                    },
                    "$icon": "PiSlackLogo",
                    "$bgColor": "gray.700"
          },
          "updateProfile": {
                    "$view": "icon-label",
                    "$label": {
                              "$state": "root.steps.3.name"
                    },
                    "$icon": "PiSlackLogo",
                    "$bgColor": "gray.700"
          }
}