{
          "id": "it-ops",
          "name": "IT Ops Workflow",
          "trigger": {
                    "type": "event",
                    "event": "user.created"
          },
          "models": {
                    "example-model": {
                              "name": "Example Model",
                              "provider": "example",
                              "model": "example-model"
                    }
          },
          "memorySources": {
                    "knowledge_entry": { "name": "Knowledge Entries", "entityType": "knowledge_entry" },
                    "support_qa": { "name": "Support Answers", "entityType": "support_qa" }
          },
          "tools": {
                    "directory_lookup": {
                              "name": "Directory Lookup",
                              "description": "Look up a user in the shared directory.",
                              "method": "GET",
                              "url": "https://example.com/directory/users"
                    },
                    "issue_lookup": {
                              "name": "Issue Lookup",
                              "description": "Find support issues for a user.",
                              "method": "GET",
                              "url": "https://example.com/issues"
                    }
          },
          "texts": {
                    "user_review": {
                              "name": "User Review Prompt",
                              "content": "Review the new user and determine whether they are a manager."
                    },
                    "directory_guidance": {
                              "name": "Directory Instructions",
                              "content": "Use the directory tools to verify the user before suggesting profile changes."
                    }
          },
          "steps": [
                    {
                              "id": "assistant",
                              "name": "AI Agent",
                              "type": "llm",
                              "config": {
                                        "promptId": "user_review",
                                        "instructionIds": [
                                                  "directory_guidance"
                                        ],
                                        "model": "example-model",
                                        "memory": [
                                                  "knowledge_entry"
                                        ],
                                        "tools": [
                                                  "directory_lookup",
                                                  "issue_lookup"
                                        ],
                                        "temperature": 0.3
                              }
                    },
                    {
                              "id": "manager-check",
                              "name": "Is a manager?",
                              "type": "conditional",
                              "config": {
                                        "condition": "return input.isManager === true;",
                                        "onTrue": "add-channel",
                                        "onFalse": "update-profile"
                              }
                    },
                    {
                              "id": "add-channel",
                              "name": "Add to channel",
                              "type": "http",
                              "config": {
                                        "method": "POST",
                                        "url": "",
                                        "body": ""
                              }
                    },
                    {
                              "id": "update-profile",
                              "name": "Update profile",
                              "type": "http",
                              "config": {
                                        "method": "POST",
                                        "url": "",
                                        "body": ""
                              }
                    }
          ]
}