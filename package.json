{
  "name": "@squeed/flow-sdk",
  "version": "0.1.0",
  "description": "Standalone React component for rendering interactive flow diagrams from JSON",
  "license": "MIT",
  "author": "seyi ogunbowale",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@chakra-ui/react": "^2.0.0",
    "@chakra-ui/icons": "^2.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "framer-motion": "^11.0.0"
  },
  "dependencies": {
    "cytoscape": "^3.33.0",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-dom-node": "github:sciphergfx/cytoscape-dom-node",
    "cytoscape-edgehandles": "^4.0.1",
    "lodash": "^4.17.21",
    "react-icons": "^5.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.0.0"
  }
}
