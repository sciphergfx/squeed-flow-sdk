{
  "name": "@squeed/flow-sdk",
  "version": "2.0.39",
  "description": "Standalone React component for rendering interactive flow diagrams using JSON",
  "license": "AGPL-3.0",
  "author": "seyi ogunbowale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sciphergfx/squeed-flow-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sciphergfx/squeed-flow-sdk/issues"
  },
  "homepage": "https://github.com/sciphergfx/squeed-flow-sdk#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node tests/run-unit.mjs",
    "test:browser": "npm run build && playwright test",
    "test:package": "npm run build && node tests/check-package.mjs",
    "check:release": "npm test && node tests/check-package.mjs && npm audit --omit=dev --audit-level=moderate",
    "prepack": "npm run build",
    "test:serve": "vite --config tests/vite.config.ts --host 127.0.0.1 --port 4196 --strictPort"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "markdown-to-jsx": "^9.10.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-icons": "^5.3.0"
  },
  "dependencies": {
    "dagre": "0.8.5",
    "dompurify": "^3.4.15",
    "html-to-image": "^1.11.13",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "next-themes": "^0.4.6",
    "typescript": "^5.6.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/dagre": "^0.7.52",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.28.2",
    "markdown-to-jsx": "^9.10.2",
    "react-icons": "^5.7.0",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.0.0"
  }
}